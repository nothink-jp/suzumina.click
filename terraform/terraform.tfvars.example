# 変数の設定例
# このファイルの名前を terraform.tfvars に変更し、実際の値を入力してください
# 機密データを含む場合は、terraform.tfvars をバージョン管理から除外してください

# GCPプロジェクトの識別子
gcp_project_id = "your-gcp-project-id"   # あなたのGCPプロジェクトID

# GCPリージョン（デフォルト: asia-northeast1）
region = "asia-northeast1"             # 東京リージョン

# 環境設定（production のみ。staging は SPR-100 で廃止）
environment = "production"

# 監視・アラート設定
admin_email = "your-email@example.com"           # 監視アラート通知先メールアドレス

# カスタムドメイン設定（オプション）
custom_domain = "suzumina.click"                # カスタムドメイン名

# アプリの機密（Discord / better-auth / Resend / YouTube / Gemini）は terraform 変数ではない。
# 値は Secret Manager に直接入れる（gcloud secrets versions add）。secrets.tf を参照。

# ===========================================
# Cloudflare設定
# ===========================================

# Cloudflare APIトークンは terraform 変数ではなく環境変数で渡す（providers.tf）
# https://dash.cloudflare.com/profile/api-tokens から作成（対象ゾーンは suzumina.click に絞る）
#   plan だけ: Zone:Read, Zone Settings:Read, Cache Rules:Read, DNS:Read
#   apply も:  Zone:Read, Zone Settings:Edit, Cache Rules:Edit, DNS:Edit
# export CLOUDFLARE_API_TOKEN="your-cloudflare-api-token-here"

